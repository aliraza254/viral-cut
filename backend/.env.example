# ViralCut Backend Environment Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=true

# Google Gemini API Key
GEMINI_API_KEY=

# Path to FFmpeg executable (optional if ffmpeg is in PATH or imageio_ffmpeg is installed)
FFMPEG_PATH=

# Storage directories
UPLOAD_DIR=./uploads
RENDER_DIR=./renders
TEMP_DIR=./temp

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
